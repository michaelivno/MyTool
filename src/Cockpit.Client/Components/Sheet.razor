@* Bottom sheet on phones, centered dialog on desktop. Closes on backdrop tap or Escape. *@
@if (Open)
{
    <div class="sheet-backdrop" @onclick="Close" @onkeydown="OnKey" tabindex="-1">
        <div class="sheet @Class" role="dialog" aria-modal="true" aria-label="@Title" @onclick:stopPropagation>
            <div class="sheet-handle"></div>
            @if (!string.IsNullOrEmpty(Title))
            {
                <div class="sheet-head">
                    <h2 dir="auto">@Title</h2>
                    <button type="button" class="icon-btn" aria-label="Close" @onclick="Close">✕</button>
                </div>
            }
            <div class="sheet-body">@ChildContent</div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private Task Close() => OnClose.InvokeAsync();
    private Task OnKey(KeyboardEventArgs e) => e.Key == "Escape" ? Close() : Task.CompletedTask;
}
