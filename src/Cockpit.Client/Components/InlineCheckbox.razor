<label class="check @Class">
    <input type="checkbox" checked="@Value" @onchange="e => ValueChanged.InvokeAsync((bool?)e.Value ?? false)" disabled="@Disabled" />
    <span class="check-box" aria-hidden="true"></span>
    @if (!string.IsNullOrEmpty(Label)) { <span class="check-label" dir="auto">@Label</span> }
</label>

@code {
    [Parameter] public bool Value { get; set; }
    [Parameter] public EventCallback<bool> ValueChanged { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public bool Disabled { get; set; }
}
