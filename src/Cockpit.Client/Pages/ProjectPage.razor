@page "/projects/{Id:guid}"
@inject ApiClient Api
@inject AppState State
@inject ToastService Toasts
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>@(_p?.Name ?? "Project") · Cockpit</PageTitle>

<div class="page">
    @if (_p is null)
    {
        <p class="muted">@(_missing ? "Project not found." : "Loading…")</p>
    }
    else
    {
        <nav class="crumbs"><a href="board">Projects</a> <span>/</span> <InlineChoice Value="@_p.AreaId.ToString()" ValueChanged="v => Save(p => p.AreaId = Guid.Parse(v!))" Options="AreaOptions" Class="tiny" Title="Move to another area" /></nav>

        <header class="page-head project-head">
            <InlineText Value="@_p.Name" ValueChanged="v => Save(p => p.Name = v ?? p.Name)" NullIfEmpty="false" Class="h1" Placeholder="Project name" />
            <button type="button" class="icon-btn" aria-label="Project actions" @onclick="() => _menu = true">⋯</button>
        </header>

        <div class="field-row">
            <InlineSelect TValue="ProjectStatus" Value="@_p.Status" ValueChanged="v => ChangeStatus(v!.Value)" Class="status" Title="Status" />
            <InlineSelect TValue="Priority" Value="@_p.Priority" ValueChanged="v => Save(p => p.Priority = v!.Value)" Title="Priority" Prefix="Priority: " />
            <InlineDate Value="@_p.Deadline" ValueChanged="v => Save(p => p.Deadline = v)" Placeholder="Deadline" Prefix="⏱ " Title="Deadline" Urgency="@(!_p.Status.IsClosed())" />
            @if (_p.Status == ProjectStatus.Parked)
            {
                <InlineDate Value="@_p.RevisitAt" ValueChanged="v => Save(p => p.RevisitAt = v)" Placeholder="Revisit" Prefix="↻ " Title="Revisit on" Clearable="false" Urgency="false" />
            }
            @if (_p.CompletedAt is { } done)
            {
                <span class="chip muted">finished @Format.Ago(done)</span>
            }
        </div>

        <dl class="props">
            <dt>Goal</dt><dd><InlineText Value="@_p.Goal" ValueChanged="v => Save(p => p.Goal = v)" Placeholder="Why does this project exist? What does done look like?" /></dd>
            <dt>Next milestone</dt><dd><InlineText Value="@_p.NextMilestone" ValueChanged="v => Save(p => p.NextMilestone = v)" Placeholder="The next visible step" /></dd>
        </dl>

        <CustomFields AreaId="_p.AreaId" Target="FieldTarget.Project" Properties="_p.Properties" PropertiesChanged="v => Save(p => p.Properties = v)" />

        <section class="group">
            <h2 class="group-head">Tasks <span class="count">@_tasks.Count(t => t.Status.IsOpen())</span>
                <button type="button" class="link small" @onclick="ToggleClosed">@(_showClosed ? "hide done" : "show done")</button>
            </h2>
            <form class="add-row" @onsubmit="AddTask" @onsubmit:preventDefault>
                <input class="input" dir="auto" placeholder="Next action…" value="@_newTask" @oninput="e => _newTask = e.Value?.ToString() ?? string.Empty" enterkeyhint="done" autocomplete="off" />
                <button type="submit" class="btn" disabled="@string.IsNullOrWhiteSpace(_newTask)">Add</button>
            </form>
            @if (_p.Status == ProjectStatus.Active && !_tasks.Any(t => t.Status.IsOpen()))
            {
                <p class="warn-line">⚠ Active project without a next action. Add one above.</p>
            }
            @foreach (var t in _tasks.Where(t => _showClosed || t.Status.IsOpen()))
            {
                <TaskRow @key="t.Id" Task="t" OnDeleted="d => _tasks.Remove(d)" />
            }
        </section>

        <section class="group">
            <h2 class="group-head">Notes <span class="muted small">markdown</span></h2>
            <InlineText Value="@_p.Notes" ValueChanged="v => Save(p => p.Notes = v)" Multiline="true" Rows="8" Placeholder="Notes, links, decisions… (tap to edit)" Class="notes" />
        </section>

        <footer class="page-foot muted">created @Format.Ago(_p.CreatedAt) · updated @Format.Ago(_p.UpdatedAt)</footer>
    }
</div>

<StatusFlow @ref="_flow" />

<Sheet Open="_menu" Title="@_p?.Name" OnClose="() => _menu = false">
    <div class="menu-list">
        @foreach (var s in Enum.GetValues<ProjectStatus>())
        {
            if (_p is null || s == _p.Status) continue;
            <button type="button" class="menu-item" @onclick="() => { _menu = false; return ChangeStatus(s); }">Move to <strong>@Format.Label(s)</strong></button>
        }
        <button type="button" class="menu-item danger" @onclick="Delete">Delete project</button>
    </div>
</Sheet>

@code {
    [Parameter] public Guid Id { get; set; }

    private ProjectDto? _p;
    private bool _missing;
    private List<TaskDto> _tasks = new();
    private bool _showClosed;
    private string _newTask = "";
    private bool _menu;
    private StatusFlow _flow = default!;

    private IReadOnlyList<InlineChoice.Option> AreaOptions => State.Areas.Select(a => new InlineChoice.Option(a.Id.ToString(), a.Name)).ToList();

    protected override async Task OnParametersSetAsync()
    {
        _p = null; _missing = false;
        try
        {
            _p = await Api.GetProject(Id);
            _tasks = await Api.GetTasks(projectId: Id, includeClosed: true);
        }
        catch (ApiException ex) when (ex.Status == System.Net.HttpStatusCode.NotFound) { _missing = true; }
        catch (Exception ex) { Toasts.Error(ex); }
    }

    private async Task Save(Action<ProjectDto> mutate)
    {
        if (_p is null) return;
        var snapshot = System.Text.Json.JsonSerializer.Serialize(_p, CockpitJson.Options);
        mutate(_p);
        if (await _flow.SaveAsync(_p) is null)
        {
            _p = System.Text.Json.JsonSerializer.Deserialize<ProjectDto>(snapshot, CockpitJson.Options);
        }
    }

    private async Task ChangeStatus(ProjectStatus s)
    {
        if (_p is null || s == _p.Status) return;
        await _flow.ChangeStatusAsync(_p, s);
        StateHasChanged();
    }

    private void ToggleClosed() => _showClosed = !_showClosed;

    private async Task AddTask()
    {
        if (_p is null || string.IsNullOrWhiteSpace(_newTask)) return;
        try
        {
            var created = await Api.CreateTask(new TaskDto { ProjectId = _p.Id, AreaId = _p.AreaId, Title = _newTask.Trim() });
            _tasks.Add(created);
            _newTask = "";
            _ = State.RefreshNavAsync();
        }
        catch (Exception ex) { Toasts.Error(ex); }
    }

    private async Task Delete()
    {
        _menu = false;
        if (_p is null) return;
        if (!await JS.InvokeAsync<bool>("confirm", $"Delete “{_p.Name}” and its tasks? (Soft delete: it stays in the database and in exports.)")) return;
        try
        {
            await Api.DeleteProject(_p.Id);
            Toasts.Info("Project deleted.");
            _ = State.RefreshNavAsync();
            Nav.NavigateTo("board");
        }
        catch (Exception ex) { Toasts.Error(ex); }
    }
}
