@page "/settings"
@inject ApiClient Api
@inject AppState State
@inject ToastService Toasts
@inject IJSRuntime JS

<PageTitle>Settings · Cockpit</PageTitle>

<div class="page">
    <header class="page-head"><h1>Settings</h1></header>

    <section class="group">
        <h2 class="group-head">Rules</h2>
        <dl class="props">
            <dt>WIP limit</dt>
            <dd><input type="number" class="input narrow" min="1" max="50" value="@_settings.WipLimit" @onchange="e => SaveSettings(s => s.WipLimit = int.TryParse(e.Value?.ToString(), out var n) ? n : s.WipLimit)" /> <span class="muted small">max active projects at once</span></dd>
            <dt>Inbox stale after</dt>
            <dd><input type="number" class="input narrow" min="1" max="365" value="@_settings.InboxStaleDays" @onchange="e => SaveSettings(s => s.InboxStaleDays = int.TryParse(e.Value?.ToString(), out var n) ? n : s.InboxStaleDays)" /> <span class="muted small">days; the weekly review warns about older unprocessed items</span></dd>
        </dl>
    </section>

    <section class="group">
        <h2 class="group-head">Areas <button type="button" class="link small" @onclick="ToggleArchived">@(_showArchived ? "hide archived" : "show archived")</button></h2>
        @foreach (var a in _areas.Where(a => _showArchived || !a.Archived))
        {
            <div class="card area-row @(a.Archived ? "archived" : "")" @key="a.Id">
                <label class="color-pick" title="Color"><input type="color" value="@a.Color" @onchange="e => SaveArea(a, x => x.Color = e.Value?.ToString() ?? x.Color)" /></label>
                <InlineText Value="@a.Name" ValueChanged="v => SaveArea(a, x => x.Name = v ?? x.Name)" NullIfEmpty="false" Class="area-name" />
                <InlineSelect TValue="AreaKind" Value="@a.Kind" ValueChanged="v => SaveArea(a, x => x.Kind = v!.Value)" Class="tiny" Title="Kind" />
                <InlineSelect TValue="ReviewCadence" Value="@a.ReviewCadence" ValueChanged="v => SaveArea(a, x => x.ReviewCadence = v!.Value)" Class="tiny" Title="Review cadence" />
                <a class="link small" href="areas/@a.Id">open</a>
                <button type="button" class="link small" @onclick="() => SaveArea(a, x => x.Archived = !x.Archived)">@(a.Archived ? "unarchive" : "archive")</button>
            </div>
        }
        <form class="add-row" @onsubmit="AddArea" @onsubmit:preventDefault>
            <input class="input" dir="auto" placeholder="New area name…" value="@_newArea" @oninput="e => _newArea = e.Value?.ToString() ?? string.Empty" autocomplete="off" />
            <InlineSelect TValue="AreaKind" Value="@_newKind" ValueChanged="v => _newKind = v!.Value" Title="Kind" />
            <button type="submit" class="btn" disabled="@string.IsNullOrWhiteSpace(_newArea)">Add</button>
        </form>
    </section>

    <section class="group">
        <h2 class="group-head">Your data</h2>
        <p class="muted small">Everything lives in one SQLite file on your server. Export is lossless (ids, timestamps and deleted items included) and can be re-imported here.</p>
        <div class="btn-row">
            <a class="btn primary" href="api/export/json" download>Export JSON</a>
        </div>
        <div class="import">
            <label class="field-label">Import a JSON export</label>
            <div class="seg">
                <button type="button" class="seg-item @(_importMode == ImportMode.Merge ? "active" : "")" @onclick="() => _importMode = ImportMode.Merge">Merge (upsert by id)</button>
                <button type="button" class="seg-item @(_importMode == ImportMode.Replace ? "active" : "")" @onclick="() => _importMode = ImportMode.Replace">Replace everything</button>
            </div>
            <InputFile OnChange="OnImportFile" accept=".json,application/json" />
            @if (_importResult is not null)
            {
                <p class="ok-line">Imported (@Format.Label(_importResult.Mode)): @_importResult.Areas areas, @_importResult.Projects projects, @_importResult.Tasks tasks, @_importResult.InboxItems inbox items, @_importResult.Reviews reviews.</p>
            }
        </div>
    </section>
</div>

@code {
    private SettingsDto _settings = new();
    private List<AreaDto> _areas = new();
    private bool _showArchived;
    private string _newArea = "";
    private AreaKind _newKind = AreaKind.Other;
    private ImportMode _importMode = ImportMode.Merge;
    private ImportResult? _importResult;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _settings = await Api.GetSettings();
            _areas = await Api.GetAreas(includeArchived: true);
        }
        catch (Exception ex) { Toasts.Error(ex); }
    }

    private async Task SaveSettings(Action<SettingsDto> mutate)
    {
        mutate(_settings);
        try { _settings = await Api.SaveSettings(_settings); await State.RefreshSettingsAsync(); _ = State.RefreshNavAsync(); Toasts.Success("Saved."); }
        catch (Exception ex) { Toasts.Error(ex); }
    }

    private async Task SaveArea(AreaDto a, Action<AreaDto> mutate)
    {
        mutate(a);
        try
        {
            var saved = await Api.SaveArea(a);
            var idx = _areas.FindIndex(x => x.Id == a.Id);
            if (idx >= 0) _areas[idx] = saved;
            await State.RefreshAreasAsync();
        }
        catch (Exception ex) { Toasts.Error(ex); }
    }

    private void ToggleArchived() => _showArchived = !_showArchived;

    private async Task AddArea()
    {
        if (string.IsNullOrWhiteSpace(_newArea)) return;
        try
        {
            _areas.Add(await Api.CreateArea(new AreaDto { Name = _newArea.Trim(), Kind = _newKind, Color = PickColor(_areas.Count) }));
            _newArea = "";
            await State.RefreshAreasAsync();
        }
        catch (Exception ex) { Toasts.Error(ex); }
    }

    private static string PickColor(int i) => new[] { "#3b82f6", "#8b5cf6", "#f59e0b", "#ec4899", "#10b981", "#14b8a6", "#ef4444", "#6366f1", "#84cc16" }[i % 9];

    private async Task OnImportFile(InputFileChangeEventArgs e)
    {
        _importResult = null;
        try
        {
            if (_importMode == ImportMode.Replace && !await JS.InvokeAsync<bool>("confirm", "Replace ALL current data with the file's contents? Export first if unsure."))
                return;
            await using var stream = e.File.OpenReadStream(maxAllowedSize: 200 * 1024 * 1024);
            var doc = await System.Text.Json.JsonSerializer.DeserializeAsync<ExportDocument>(stream, CockpitJson.Options);
            if (doc is null) { Toasts.Error("Could not read that file."); return; }
            _importResult = await Api.Import(doc, _importMode);
            await State.RefreshAsync();
            _areas = await Api.GetAreas(includeArchived: true);
            _settings = await Api.GetSettings();
            Toasts.Success("Import finished.");
        }
        catch (Exception ex) { Toasts.Error(ex); }
    }
}
