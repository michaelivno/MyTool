@inherits LayoutComponentBase
@inject AppState State
@inject ToastService Toasts
@inject ApiClient Api
@inject AuthSignal Auth
@inject IJSRuntime JS
@implements IDisposable

@if (_locked)
{
    <Login OnLoggedIn="Unlocked" />
    <Toasts />
    return;
}

<div class="shell">
    <aside class="sidebar">
        <div class="brand"><span class="brand-mark">◎</span> Cockpit</div>
        <NavLinks Counts="State.Nav" />
        <button type="button" class="theme-toggle" @onclick="ToggleTheme" title="Toggle dark mode">◐ Theme</button>
    </aside>

    <main class="content">
        @if (!State.Loaded && _error is null)
        {
            <div class="page"><p class="muted">Loading…</p></div>
        }
        else if (_error is not null)
        {
            <div class="page">
                <h1>Can't reach the server</h1>
                <p class="muted">@_error</p>
                <button class="btn" @onclick="Load">Retry</button>
            </div>
        }
        else
        {
            @Body
        }
    </main>

    <nav class="bottom-nav">
        <NavLink href="" Match="NavLinkMatch.All" class="bn-item"><span class="bn-icon">☀</span><span>Today</span>@Badge(State.Nav.Today)</NavLink>
        <NavLink href="week" class="bn-item"><span class="bn-icon">▦</span><span>Week</span></NavLink>
        <NavLink href="board" class="bn-item"><span class="bn-icon">▤</span><span>Board</span></NavLink>
        <NavLink href="inbox" class="bn-item"><span class="bn-icon">⌲</span><span>Inbox</span>@Badge(State.Nav.Inbox)</NavLink>
        <button type="button" class="bn-item @(_more ? "active" : "")" @onclick="() => _more = !_more"><span class="bn-icon">⋯</span><span>More</span>@Badge(State.Nav.Decide)</button>
    </nav>

    <Sheet Open="_more" Title="More" OnClose="() => _more = false">
        <div class="more-grid" @onclick="() => _more = false">
            <NavLink href="areas" class="more-item"><span class="bn-icon">◫</span>Areas</NavLink>
            <NavLink href="decide" class="more-item"><span class="bn-icon">⚖</span>Decide @Badge(State.Nav.Decide)</NavLink>
            <NavLink href="review" class="more-item"><span class="bn-icon">↻</span>Weekly review</NavLink>
            <NavLink href="settings" class="more-item"><span class="bn-icon">⚙</span>Settings</NavLink>
            <button type="button" class="more-item" @onclick="ToggleTheme"><span class="bn-icon">◐</span>Theme</button>
        </div>
    </Sheet>

    <Toasts />
</div>

@code {
    private bool _more;
    private bool _locked;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        State.Changed += OnChanged;
        Toasts.Changed += OnChanged;
        Auth.Locked += OnLocked;
        await Load();
    }

    private async Task Load()
    {
        _error = null;
        try
        {
            var status = await Api.GetAuthStatus();
            if (status.Required && !status.Authenticated) { _locked = true; return; }
            await State.RefreshAsync();
        }
        catch (ApiException ex) when (ex.Status == System.Net.HttpStatusCode.Unauthorized) { _locked = true; }
        catch (Exception ex) { _error = ex.Message; }
    }

    private void OnLocked() { _locked = true; InvokeAsync(StateHasChanged); }

    private async Task Unlocked()
    {
        _locked = false;
        await Load();
        StateHasChanged();
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private async Task ToggleTheme() => await JS.InvokeVoidAsync("cockpit.toggleTheme");

    private static RenderFragment? Badge(int n) => n <= 0 ? null : b => { b.OpenElement(0, "span"); b.AddAttribute(1, "class", "badge"); b.AddContent(2, n > 99 ? "99+" : n.ToString()); b.CloseElement(); };

    public void Dispose()
    {
        State.Changed -= OnChanged;
        Toasts.Changed -= OnChanged;
        Auth.Locked -= OnLocked;
    }
}
